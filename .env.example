# Copier ce fichier en .env et renseigner les valeurs (ne jamais commiter .env)
PORT=3000
CLIENT_URL=https://terraophis.fr

# Firebase Admin : coller le JSON complet de la clé de compte de service sur une seule ligne
# (alternative : déposer serviceAccountKey.json à la racine du serveur, hors Git)
FIREBASE_SERVICE_ACCOUNT=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SMTP_EMAIL=
SMTP_PASSWORD=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
